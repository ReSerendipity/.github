      "backup": { "sections": ["3"] },
      "policy": { "sections": ["1-20"] }
    },
    "distribution": {
      "github-release": { "checks": ["sha256", "release-notes", "rollback"] },
      "ghcr": { "checks": ["trivy", "provenance", "sbom"] },
      "pages": { "checks": ["deploy-rollback"] },
      "direct-ssh": { "checks": ["deploy-rollback"] },
